<Window x:Class="VbaLoop.Updater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="vbaloop 업데이트" Icon="Assets/updater.ico" Width="800" Height="720" MinWidth="620" MinHeight="540"
        WindowStartupLocation="CenterScreen" Background="White" FontFamily="Malgun Gothic"
        FontSize="14" Foreground="#192321" UseLayoutRounding="True" SnapsToDevicePixels="True"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" Closing="OnClosing">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#087346"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#273D35"/>
            <Setter Property="BorderBrush" Value="#CCD5D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.83"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#153FBD"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="22"/></Style>
        <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="#57685F"/><Setter Property="FontSize" Value="13"/><Setter Property="LineHeight" Value="20"/></Style>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
        <Style x:Key="FileName" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="LineHeight" Value="24"/></Style>
        <Style x:Key="EmptyFile" TargetType="TextBlock" BasedOn="{StaticResource FileName}"><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Foreground" Value="#57685F"/></Style>
        <Style x:Key="Version" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="30"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="LineHeight" Value="40"/><Setter Property="Margin" Value="0,5,0,0"/></Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="#F6F8F7" BorderBrush="#E5EAE7" BorderThickness="0,0,0,1" Padding="32,0">
            <DockPanel VerticalAlignment="Center">
                <Button x:Name="DiagnosticsButton" DockPanel.Dock="Right" Content="진단 로그 저장" Click="SaveDiagnostics"
                        FontSize="13" Padding="12,6" MinHeight="32" Margin="16,0,0,0"
                        ToolTip="실행 기록을 ZIP으로 저장합니다. 대화상자 제목에 파일명이 포함될 수 있습니다."/>
                <Path Width="28" Height="18" Margin="0,0,10,0" Stroke="{StaticResource Accent}" StrokeThickness="2.5"
                      Stretch="Uniform" Data="M 14,9 C 8,-2 0,1 0,9 C 0,17 8,20 14,9 C 20,-2 28,1 28,9 C 28,17 20,20 14,9"/>
                <TextBlock Text="vbaloop" FontFamily="Segoe UI" FontSize="20" LineHeight="28" FontWeight="SemiBold"/>
                <TextBlock x:Name="PreviewLabel" Visibility="Collapsed" Text="디자인 미리보기 · 예시 데이터" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Caption}"/>
            </DockPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="40,30,40,28">
                <TextBlock x:Name="StatusLabel" Text="오프라인 업데이트" Foreground="{StaticResource Accent}" FontSize="12" LineHeight="18" Margin="0,0,0,8"/>
                <TextBlock x:Name="Heading" Text="업무 파일 업데이트" FontSize="26" FontWeight="SemiBold" LineHeight="36"/>
                <TextBlock x:Name="Subtitle" Text="받은 패키지와 업데이트할 Excel 파일을 선택해 주세요." Foreground="#57685F" Margin="0,8,0,28"/>

                <StackPanel x:Name="SelectPanel">
                    <Border BorderBrush="#B7C7BF" BorderThickness="1" CornerRadius="8" Background="#FAFCFB" Padding="24">
                        <StackPanel>
                            <TextBlock Text="업데이트 패키지" Style="{StaticResource Section}"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                                    <TextBlock x:Name="SelectedPackage" Text="전달받은 TXT 패키지" Style="{StaticResource EmptyFile}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="SelectedPackagePath" Text=".txt" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                                </StackPanel>
                                <Button x:Name="PackagePickButton" Grid.Column="1" Content="패키지 선택" Click="PickPackage" VerticalAlignment="Center" Width="140" AutomationProperties.Name="업데이트 패키지 선택 또는 변경"/>
                            </Grid>
                            <Border BorderBrush="#E2E8E4" BorderThickness="0,1,0,0" Margin="0,24,0,0" Padding="0,24,0,0">
                                <StackPanel>
                                    <TextBlock Text="대상 Excel 파일" Style="{StaticResource Section}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                                            <TextBlock x:Name="SelectedWorkbook" Text="업데이트할 업무 파일" Style="{StaticResource EmptyFile}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="SelectedWorkbookPath" Text=".xlsm · .xlsb · .xlam" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="WorkbookPickButton" Grid.Column="1" Content="Excel 파일 선택" Click="PickWorkbook" VerticalAlignment="Center" Width="140" AutomationProperties.Name="대상 Excel 파일 선택 또는 변경"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="파일을 이 창에 끌어다 놓아도 됩니다." Style="{StaticResource Caption}" Margin="0,16,0,0"/>
                    <TextBlock Text="대상 파일은 Excel에서 닫아 주세요." Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel x:Name="ReadyPanel" Visibility="Collapsed">
                    <Grid Margin="0,0,0,28">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="현재 버전" Style="{StaticResource Caption}"/><TextBlock x:Name="FromVersion" Style="{StaticResource Version}"/></StackPanel>
                        <Path Grid.Column="1" Data="M 0,8 L 22,8 M 14,0 L 22,8 L 14,16" Stroke="#57685F" StrokeThickness="2" Width="24" Height="18" Stretch="Uniform" VerticalAlignment="Bottom" Margin="0,0,0,14"/>
                        <StackPanel Grid.Column="2"><TextBlock Text="새 버전" Style="{StaticResource Caption}"/><TextBlock x:Name="ToVersion" Style="{StaticResource Version}" Foreground="{StaticResource Accent}"/></StackPanel>
                    </Grid>
                    <TextBlock Text="업무 파일" Style="{StaticResource Section}"/>
                    <Grid Margin="0,0,0,22">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0"><TextBlock x:Name="WorkbookName" Style="{StaticResource FileName}"/><TextBlock x:Name="WorkbookPath" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,5,0,0"/></StackPanel>
                        <Button Grid.Column="1" Content="변경" Click="PickWorkbook" VerticalAlignment="Center" AutomationProperties.Name="업무 파일 변경"/>
                    </Grid>
                    <Border BorderBrush="#E2E8E4" BorderThickness="0,1,0,0" Padding="0,20,0,0">
                        <StackPanel><TextBlock Text="업데이트 패키지" Style="{StaticResource Section}"/>
                            <DockPanel LastChildFill="True"><Button DockPanel.Dock="Right" Content="변경" Click="PickPackage" Margin="16,0,0,0" AutomationProperties.Name="패키지 변경"/><StackPanel><TextBlock x:Name="PackageName" Style="{StaticResource FileName}"/><TextBlock Text="검사 완료" Foreground="{StaticResource Accent}" FontSize="13" Margin="0,5,0,0"/></StackPanel></DockPanel>
                        </StackPanel>
                    </Border>
                    <Expander Margin="0,22,0,0" Padding="12" Background="#F3F6F4" BorderBrush="#E1E7E3" BorderThickness="1">
                        <Expander.Header><TextBlock x:Name="ChangeSummary" FontWeight="SemiBold" Margin="7,2"/></Expander.Header>
                        <TextBox x:Name="Changes" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Margin="20,12,0,4" MaxHeight="190" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="모듈 변경 상세"/>
                    </Expander>
                    <TextBlock x:Name="WarningText" Foreground="#8B4E13" Margin="0,14,0,0" Visibility="Collapsed"/>
                    <CheckBox x:Name="AdoptCheck" Visibility="Collapsed" Margin="0,18,0,0" Checked="AdoptionChanged" Unchecked="AdoptionChanged">
                        <TextBlock x:Name="AdoptText" TextWrapping="Wrap" MaxWidth="550"/>
                    </CheckBox>
                    <TextBlock Text="업데이트 전에 원본 파일을 자동으로 백업합니다." Style="{StaticResource Caption}" Margin="0,22,0,0"/>
                </StackPanel>

                <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,22,0,0">
                    <ProgressBar IsIndeterminate="True" Height="5" Foreground="{StaticResource Accent}" Background="#E4EBE6" BorderThickness="0"/>
                    <TextBlock x:Name="ProgressLabel" Text="실행 도구를 준비하고 있습니다" FontSize="18" LineHeight="28" FontWeight="SemiBold" Margin="0,28,0,12" AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock x:Name="ProgressSteps" Foreground="#57685F" LineHeight="26"/>
                    <TextBlock Text="완료될 때까지 창을 열어 두세요." Style="{StaticResource Caption}" Margin="0,24,0,0"/>
                </StackPanel>

                <StackPanel x:Name="DonePanel" Visibility="Collapsed" Margin="0,18,0,0">
                    <Grid Width="68" Height="68" HorizontalAlignment="Left" Margin="0,0,0,24">
                        <Ellipse Stroke="{StaticResource Accent}" StrokeThickness="2"/>
                        <Path Stroke="{StaticResource Accent}" StrokeThickness="3" Data="M 18,34 L 29,45 L 50,23"/>
                    </Grid>
                    <TextBlock x:Name="DoneDescription" FontSize="16" LineHeight="26"/>
                    <Button x:Name="BackupButton" Content="백업 폴더 열기" Click="OpenBackup" HorizontalAlignment="Left" Margin="0,26,0,0"/>
                    <TextBlock x:Name="BackupDescription" Style="{StaticResource Caption}" Margin="0,12,0,0"/>
                </StackPanel>

                <StackPanel x:Name="ErrorPanel" Visibility="Collapsed">
                    <Border Background="#FFF7ED" CornerRadius="6" Padding="20"><TextBlock x:Name="ErrorMessage" Foreground="#804312"/></Border>
                    <Expander Header="오류 상세" Margin="0,20,0,0"><TextBox x:Name="ErrorDetails" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="190" VerticalScrollBarVisibility="Auto" Padding="10" Margin="0,10,0,0"/></Expander>
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0"><Button Content="상세 복사" Click="CopyError"/><Button x:Name="ErrorBackupButton" Content="백업 폴더 열기" Click="OpenBackup" Margin="12,0,0,0" Visibility="Collapsed"/></StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" BorderBrush="#E2E8E4" BorderThickness="0,1,0,0" Padding="32,18">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="SelectionHint" Text="두 파일을 선택해 주세요." Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,20,0" AutomationProperties.LiveSetting="Polite"/>
                <Button x:Name="BackButton" Content="처음으로" Click="Back" HorizontalAlignment="Left" Visibility="Collapsed"/>
                <Button x:Name="PrimaryButton" Content="적용 내용 확인" Click="Primary" Grid.Column="1" MinWidth="176" IsEnabled="False"
                        Background="{StaticResource Accent}" Foreground="White" BorderBrush="{StaticResource Accent}" IsDefault="True"/>
            </Grid>
        </Border>
    </Grid>
</Window>
